# ============================================================
# py_free_image_moderation - complete .env example
# Copy this file to .env and edit values there for your environment.
# This example is not loaded automatically; code defaults are used without .env.
# ============================================================

# ---------- Debug / dotenv ----------
# Logger level (e.g. DEBUG, INFO, WARNING, ERROR)
MODIMG_LOG_LEVEL=INFO
# 1 = modimg debug mode
MODIMG_DEBUG=0
# Legacy alias for modimg debug mode; enables diagnostic trace details in reports
DEBUG=0
# 1 = override existing shell env vars with dotenv values
DOTENV_OVERRIDE=0
# TensorFlow/C++ log level: 2 hides INFO+WARNING noise (keeps errors)
TF_CPP_MIN_LOG_LEVEL=2
# Default: hide CUDA devices from optional ML engines for process safety.
# Set this explicitly before launch if you want GPU inference.
CUDA_VISIBLE_DEVICES=-1

# ---------- Parallelization ----------
# 1 = run engines in parallel
MODIMG_PARALLEL_ENGINES=0
# Worker count when parallelization is enabled
MODIMG_PARALLEL_WORKERS=4
# Number of input files processed concurrently by the CLI.
# Safe default is 1. Increase carefully; too many workers can overload GPU/VRAM.
MODIMG_FILE_WORKERS=1
# Hard upper bound for --file-workers / MODIMG_FILE_WORKERS
MODIMG_MAX_FILE_WORKERS=32

# ---------- CLI / Reporting ----------
# Number of sampled frames for animated images (GIF/WebP/AVIF sequences)
SAMPLE_FRAMES=12
# URL downloads accept public HTTP(S) targets only by default. Every redirect is revalidated.
MODIMG_MAX_DOWNLOAD_BYTES=25000000
# AVIF is read into memory by Pillow; bound local sources independently.
# URL AVIFs obey this and MODIMG_MAX_DOWNLOAD_BYTES, whichever is stricter.
MODIMG_MAX_AVIF_BYTES=100000000
MODIMG_URL_TIMEOUT_SEC=20
MODIMG_MAX_URL_REDIRECTS=5
# DANGEROUS for untrusted URLs: 1 permits loopback/private/link-local URL targets.
MODIMG_ALLOW_PRIVATE_URLS=0
# Decode limits for untrusted images and animations.
MODIMG_MAX_IMAGE_DIMENSION=32768
MODIMG_MAX_IMAGE_PIXELS=64000000
MODIMG_MAX_SAMPLED_FRAMES=100
MODIMG_MAX_ANIMATION_FRAMES=5000
MODIMG_MAX_DECODED_PIXELS=256000000

# ---------- SVG preprocessing ----------
# Uncompressed SVG source limit. URL SVGs also remain subject to
# MODIMG_MAX_DOWNLOAD_BYTES; the stricter applicable limit wins.
MODIMG_MAX_SVG_BYTES=10000000
# Fallback raster size when neither absolute dimensions nor a valid viewBox exists.
MODIMG_SVG_DEFAULT_WIDTH=1024
MODIMG_SVG_DEFAULT_HEIGHT=1024
# SVG-specific render limits. Global image/decode limits above still apply and
# can only make these limits stricter.
MODIMG_SVG_MAX_RENDER_DIMENSION=4096
MODIMG_SVG_MAX_RENDER_PIXELS=16000000
# Opaque CSS background used for SVG rasterization. Invalid or transparent
# values are rejected as configuration errors.
MODIMG_SVG_BACKGROUND=#ffffff
# Permit only bounded base64 PNG/JPEG/WebP/GIF data images. External URLs,
# local paths, nested SVG data URIs, stylesheets, and external fonts are rejected.
MODIMG_SVG_ALLOW_DATA_IMAGES=1
MODIMG_SVG_MAX_EMBEDDED_IMAGE_BYTES=5000000
MODIMG_SVG_MAX_TOTAL_EMBEDDED_BYTES=10000000
# 1 = print all engine scores
SCORE_VERBOSE=0
# Max score keys shown for non-Sightengine outputs
SCORE_MAX_KEYS=8
# Sightengine score output mode: compact | full | keys
SIGHTENGINE_SCORE_MODE=compact
# Used only when SIGHTENGINE_SCORE_MODE=keys (comma-separated)
SIGHTENGINE_SCORE_KEYS=
# In compact mode, append strongest additional signals (0 = off)
SIGHTENGINE_EXTRA_TOPK=0

# ---------- API execution policy ----------
# always: run APIs after local engines
# on_review: run APIs only if local stage returns REVIEW
# never: never run API engines
API_POLICY=always

# ---------- pHash lists / behavior ----------
# Optional path to pHash allowlist
PHASH_ALLOWLIST=data/phash_allowlist.txt
# Optional path to pHash blocklist
PHASH_BLOCKLIST=data/phash_blocklist.txt
# Persistence/parser limits for pHash list files.
PHASH_LIST_MAX_BYTES=10000000
PHASH_LIST_MAX_ENTRIES=100000
PHASH_MAX_HEX_LENGTH=256

# 1 = disable pHash allowlist engine
PHASH_ALLOW_DISABLE=0
# 1 = disable pHash blocklist engine
PHASH_BLOCK_DISABLE=0

# 0 means exact pHash match is required on allowlist (strict default)
PHASH_ALLOW_MAX_DISTANCE=0
# 6 is the current tolerant default for blocklist matching
PHASH_BLOCK_MAX_DISTANCE=6
# Preferred variables are PHASH_ALLOW_MAX_DISTANCE and PHASH_BLOCK_MAX_DISTANCE.
# Legacy aliases are still recognized by current code:
# PHASH_ALLOW_MAXDIST=
# PHASH_BLOCK_MAXDIST=
# PHASH_MAXDIST=

# 1 = pHash hit short-circuits (allowlist => OK, blocklist => BLOCK)
SHORT_CIRCUIT_PHASH=1

# ---------- pHash auto-learning ----------
# Recommended default: off.
# Enable only after you trust your thresholds, otherwise false positives can be learned.
PHASH_AUTO_LEARN_ENABLE=0
# Legacy back-compat switch (still read)
PHASH_AUTO_APPEND=0
# 1 = append pHash to allowlist after OK verdict
PHASH_AUTO_ALLOW_APPEND=0
# 1 = append pHash to blocklist after BLOCK verdict
PHASH_AUTO_BLOCK_APPEND=0
# Generic auto-learn label fallback
PHASH_AUTO_LABEL=ok
# Specific labels
PHASH_AUTO_ALLOW_LABEL=ok
PHASH_AUTO_BLOCK_LABEL=not_ok
# 1 = for sampled animations learn first + last frame (instead of first only)
PHASH_GIF_LEARN_FIRST_LAST=1

# ---------- OCR ----------
# 1 = enable OCR engine
OCR_ENABLE=0
# OCR language (e.g. eng, deu, deu+eng)
OCR_LANG=eng
# Hard timeout in seconds for each external Tesseract invocation
OCR_TIMEOUT_SEC=30
# Max sampled frames OCR checks on animated GIF/WebP/AVIF images
OCR_MAX_FRAMES=2
# Minimum text length to keep OCR signal
OCR_MIN_LEN=3
# Optional explicit path to tesseract binary
TESSERACT_CMD=
# OCR input and parser limits.
OCR_BLOCKLIST_MAX_BYTES=1000000
OCR_BLOCKLIST_MAX_PATTERNS=10000
OCR_MAX_PATTERN_CHARS=1000
OCR_MAX_TEXT_CHARS=20000

# ---------- OpenNSFW2 ----------
# 1 = disable OpenNSFW2 engine
OPENNSFW2_DISABLE=0
# Prediction timeout for the isolated OpenNSFW2 subprocess
OPENNSFW2_TIMEOUT_SEC=120
# 0 = isolated subprocess for stability; 1 = faster in-process prediction that can terminate the whole process on native TensorFlow crashes; auto = in-process then one subprocess fallback on normal Python errors
OPENNSFW2_IN_PROCESS=0

# ---------- NudeNet ----------
# 1 = disable NudeNet engine
NUDENET_DISABLE=0

# ---------- YOLO weapons detection ----------
# Backend (currently implemented: ultralytics)
YOLO_BACKEND=ultralytics
# Optional model path/weights. If unset, models/yolov8s-oiv7.pt is used when present; otherwise the engine is skipped.
YOLO_WORLD_MODEL=
YOLO_WEAPON_MODEL=
YOLO_WEAPONS_WEIGHTS=
# Inference parameters
YOLO_CONF=0.25
YOLO_IOU=0.45
# Lower image size is faster but usually less accurate
YOLO_IMGSZ=640
# Maximum detections kept per frame/image
YOLO_MAX_DET=50
# Max sampled frames YOLO checks on animated GIF/WebP/AVIF images
YOLO_MAX_FRAMES=2
YOLO_DEVICE=
# 1 = batch selected frames in one Ultralytics predict call when possible
YOLO_BATCH_ENABLE=1

# Decision thresholds (verdict.py)
YOLO_FIREARM_THRESH=0.35
YOLO_FIREARM_TOY_THRESH=0.25
ALLOW_TOY_GUN=0
YOLO_DANGEROUS_KNIFE_THRESH=0.35
YOLO_KNIFE_THRESH=0.65
YOLO_KNIFE_BLOCK_ALL=0

# ---------- YOLO forbidden/harmful symbols detection ----------
# Uses the bundled local YOLO model:
# models/forbidden_symbols_yolo.pt
# This is local-only and never calls Roboflow/API. If this is a Git-LFS pointer, run `git lfs pull`.
FORBIDDEN_SYMBOLS_YOLO_ENABLE=1
FORBIDDEN_SYMBOLS_YOLO_MODEL=models/forbidden_symbols_yolo.pt
FORBIDDEN_SYMBOLS_YOLO_CONF=0.20
FORBIDDEN_SYMBOLS_YOLO_IOU=0.45
FORBIDDEN_SYMBOLS_YOLO_IMGSZ=960
FORBIDDEN_SYMBOLS_YOLO_MAX_DET=20
FORBIDDEN_SYMBOLS_YOLO_MAX_FRAMES=2
FORBIDDEN_SYMBOLS_YOLO_DEVICE=auto
# 1 = batch selected frames in one Ultralytics predict call when possible
FORBIDDEN_SYMBOLS_YOLO_BATCH_ENABLE=1
# 1 = in sequential inference, stop remaining frames after a label-specific BLOCK-threshold hit
FORBIDDEN_SYMBOLS_YOLO_STOP_AFTER_BLOCK=1
FORBIDDEN_SYMBOLS_YOLO_REVIEW_CONF=0.30
FORBIDDEN_SYMBOLS_YOLO_BLOCK_CONF=0.90
# Optional label-specific verdict thresholds (label:threshold,label2:threshold).
# These override the global review/block thresholds only for the named label; other labels keep the globals.
# Prefer this over ignoring a risky label completely: e.g. stricter isis thresholds still allow high-confidence ISIS hits.
FORBIDDEN_SYMBOLS_YOLO_LABEL_REVIEW_CONF=isis:0.75,swastika:0.50
FORBIDDEN_SYMBOLS_YOLO_LABEL_BLOCK_CONF=isis:0.92,swastika:0.90
FORBIDDEN_SYMBOLS_YOLO_INCLUDE_BOXES=1
# Optional comma-separated labels to ignore at runtime, useful for unreliable classes
FORBIDDEN_SYMBOLS_YOLO_IGNORE_LABELS=

# ---------- OpenAI moderation ----------
# 1 = disable OpenAI engine
OPENAI_DISABLE=1
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest
OPENAI_REQUEST_TIMEOUT_SEC=20
OPENAI_MIN_INTERVAL_SEC=1.0
OPENAI_MAX_RETRIES=6
OPENAI_BACKOFF_BASE_SEC=1.0
OPENAI_BACKOFF_MAX_SEC=10
OPENAI_MAX_TOTAL_SLEEP_SEC=30
# For HTTP 429: retry | skip
OPENAI_429_POLICY=retry
OPENAI_MAX_429_RETRIES=3
# Local cache. Empty uses the platform user cache directory.
# Relative overrides keep the historical project/package-root resolution.
OPENAI_CACHE_ENABLE=1
OPENAI_CACHE_PATH=
OPENAI_CACHE_MAX_ITEMS=2000
OPENAI_CACHE_MAX_BYTES=10000000
# Inclusive hard-block threshold for OpenAI sexual/minors.
OPENAI_SEXUAL_MINORS_BLOCK_THRESHOLD=0.01

# ---------- Sightengine ----------
# 1 = disable Sightengine engine even if credentials are set
SIGHTENGINE_DISABLE=0
SIGHTENGINE_USER=
SIGHTENGINE_SECRET=
SIGHTENGINE_MODELS=nudity-2.1,weapon,violence,gore-2.0,offensive-2.0
SIGHTENGINE_TIMEOUT_SEC=60

# Decision thresholds (verdict.py)
SE_FIREARM_THRESH=0.35
SE_BLOCK_ANY_FIREARM=0
SE_VIOLENCE_THRESH=0.30
SE_GORE_THRESH=0.20
SE_OFFENSIVE_THRESH=0.50
SE_KNIFE_THRESH=0.65
SE_KNIFE_BLOCK_ALL=0
SE_KNIFE_CONTEXT_THRESH=0.25

# ---------- Global verdict logic ----------
# Comma-separated engine names/aliases treated as "core"
CORE_ENGINES=
# Error policy for core engine failures: ignore | review | block
ENGINE_ERROR_POLICY=review
# Fallback when no engine ran successfully: ok | review | block
NO_CHECKS_POLICY=review
# Final thresholds
FINAL_BLOCK_THRESHOLD=0.85
FINAL_REVIEW_THRESHOLD=0.40

# ---------- Suggested fast profile ----------
# Copy these into your real .env for faster scans:
# MODIMG_PARALLEL_ENGINES=1
# MODIMG_PARALLEL_WORKERS=4
# MODIMG_FILE_WORKERS=2
# OPENNSFW2_IN_PROCESS=1
# YOLO_BATCH_ENABLE=1
# FORBIDDEN_SYMBOLS_YOLO_BATCH_ENABLE=1
# SAMPLE_FRAMES=4
# YOLO_MAX_FRAMES=1
# FORBIDDEN_SYMBOLS_YOLO_MAX_FRAMES=1
# API_POLICY=on_review
# OCR_ENABLE=0
# YOLO_IMGSZ=416
# YOLO_MAX_DET=20
# YOLO_DEVICE=cpu
# FORBIDDEN_SYMBOLS_YOLO_IMGSZ=640
# FORBIDDEN_SYMBOLS_YOLO_DEVICE=cpu
# PHASH_ALLOW_MAX_DISTANCE=0
# PHASH_BLOCK_MAX_DISTANCE=0
#
# Speed tradeoffs:
# - Fewer sampled frames can reduce accuracy for GIF/WebP/AVIF animations.
# - Too many file workers can overload GPU/VRAM; start with MODIMG_FILE_WORKERS=2.
# - Recommended first test: file-workers=2 and engine-workers=4.
